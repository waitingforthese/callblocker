<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Selected Contacts Only" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Status" android:textSize="16sp" />
    <Switch android:id="@+id/masterSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Allow only selected people" android:textSize="18sp" />
    <Button android:id="@+id/selectContact" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="+ Add allowed contact" />
    <Switch android:id="@+id/smsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Send SMS after rejected call" android:textSize="18sp" />
    <EditText android:id="@+id/smsMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="Rejected call SMS message" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
    <Button android:id="@+id/chooseScreening" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Set as Call Screening app" />
    <TextView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="18dp" android:textSize="16sp" />
</LinearLayout>
